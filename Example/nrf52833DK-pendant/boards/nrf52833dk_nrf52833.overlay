/* boards/nrf52833dk_nrf52833.overlay */
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
/ {
    leds {
        compatible = "gpio-leds";
        board_led_1: board_led_p0_13 {
            gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
            label = "Board LED 1";
        };

        board_led_2: board_led_p0_14 {
            gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
            label = "Board LED 2";
        };

        board_led_3: board_led_p0_15 {
            gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
            label = "Board LED 3";
        };

        board_led_4: board_led_p0_16 {
            gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
            label = "Board LED 4";
        };
    };

    aliases {
        led1 = &board_led_1;
        led2 = &board_led_2;
        led3 = &board_led_3;
        led4 = &board_led_4;
    };

    /*
     * Ad-hoc GPIO wiring that is not owned by a specific bus driver.
     * rs485-de-gpios drives the RS485 transceiver direction control pin
     * (DE and RE tied together for half-duplex operation on UART1).
     */
    zephyr,user {
        rs485-de-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
    };

    /*
     * Panel-agnostic display selection. Upper layers (hardware/package_display,
     * LVGL port, UI) must reference this chosen node instead of the ili9341
     * label directly, so swapping the panel model only touches this overlay.
     */
    chosen {
        zephyr,display = &ili9341;
    };
};

&pinctrl {
    uart1_default: uart1_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 1)>,
                    <NRF_PSEL(UART_RX, 1, 2)>;
        };
    };

    uart1_sleep: uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 1)>,
                    <NRF_PSEL(UART_RX, 1, 2)>;
            low-power-enable;
        };
    };

    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 3)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 28)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 3)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 28)>;
            low-power-enable;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_default>;
    pinctrl-1 = <&uart1_sleep>;
    pinctrl-names = "default", "sleep";
};

/*
 * SPI1 bus driving an ILI9341 240x320 TFT display.
 * CS is P0.29, D/CX (data/command) is P0.30, RESET is P0.31.
 */
&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;

    ili9341: ili9341@0 {
        compatible = "ilitek,ili9341";
        label = "ILI9341";
        reg = <0>;
        spi-max-frequency = <32000000>;
        dc-gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
        reset-gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;
        width = <240>;
        height = <320>;
        rotation = <0>;
        pixel-format = <0>;
    };
};
