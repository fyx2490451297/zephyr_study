config PACKAGE_KEY
	bool "Enable KEY hardware package"
	default n
	help
	  Enable the button/key GPIO driver package for nRF52833DK.
	  Provides key_register_callback() API for button event notification.
	  The module is auto-initialized via SYS_INIT at APPLICATION level.

if PACKAGE_KEY

config PACKAGE_KEY_INIT_PRIORITY
	int "KEY driver initialization priority"
	default 90
	help
	  Initialization priority for the KEY driver within APPLICATION level.

endif # PACKAGE_KEY
