config PACKAGE_LCD_UI
	bool "Enable LCD LVGL UI application module"
	default y
	depends on PACKAGE_LCD_BACKLIGHT
	depends on DISPLAY
	depends on LVGL
	help
	  Application-level LVGL UI for the ILI9341 LCD (pipe-bender dashboard,
	  ported from an LVGL v9 PC prototype to LVGL v8 widget/image APIs).
	  Runs display bring-up and the lv_task_handler() loop in a dedicated
	  thread. Depends on the LCD backlight hardware package, the display
	  subsystem, and LVGL.

if PACKAGE_LCD_UI

config PACKAGE_LCD_UI_STACK_SIZE
	int "LCD UI thread stack size (bytes)"
	default 4096
	help
	  Stack size for the LVGL task handler thread. LVGL widget creation
	  and rendering needs more stack than typical demo threads.

config PACKAGE_LCD_UI_PRIORITY
	int "LCD UI thread priority"
	default 7

config PACKAGE_LCD_UI_ASYNC_FLUSH
	bool "Use non-blocking (EasyDMA async) SPI flush for the LCD"
	default y
	depends on SPI_ASYNC
	help
	  Bypass the blocking spi_write() calls made internally by the
	  in-tree mipi_dbi_spi / ILI9341 display drivers when pushing pixel
	  data, and instead drive the SPI bus directly with
	  spi_transceive_cb() against the nRF52833 SPIM/EasyDMA peripheral.
	  lv_disp_flush_ready() is signalled from the SPI completion
	  callback, so the LCD UI thread issues the pixel DMA transfer and
	  returns immediately instead of blocking on it.

endif # PACKAGE_LCD_UI
